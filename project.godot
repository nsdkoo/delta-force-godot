; Engine configuration file.
; 三角洲行动 · 全面战场 · 胜者为王（Godot 4.7）
; 20v20 指挥官模式 · 烬区

config_version=5

[application]

config/name="三角洲行动 · 全面战场 · 胜者为王"
config/description="20v20 指挥官模式：票选指挥官、战术标记、攻防票数、干员反载具"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/show_image=false

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameConfig="*res://autoload/game_config.gd"
AssetDB="*res://autoload/asset_db.gd"
MatchState="*res://autoload/match_state.gd"
TeamManager="*res://autoload/team_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"



[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[importer_defaults]

; 地表与法线贴图必须无损导入：
;   compress/mode 0 = Lossless（VRAM 压缩会在法线图上留下可辨的块状瑕疵）
;   detect_3d/compress_to 0 = 关闭「被 3D 场景引用时自动转压缩」的行为
texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="team_gti"
2d_physics/layer_3="team_havoc"
2d_physics/layer_4="projectile"
2d_physics/layer_5="pickup"
2d_physics/layer_6="vehicle"
2d_physics/layer_7="vision_blocker"

[physics]

2d/default_gravity=0.0
2d/default_gravity_vector=Vector2(0, 0)
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.11, 0.094, 0.076, 1)
environment/glow/upscale_mode=0
2d/snap/snap_2d_transforms_to_pixel=false
anti_aliasing/quality/msaa_2d=1
viewport/hdr_2d=true
