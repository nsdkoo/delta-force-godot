; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="三角洲行动 · 全面战场 · 胜者为王"
config/description="斜俯视 2.5D 军事战场：20v20 离线攻防、票选指挥官、小队协同"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
GameConfig="*res://autoload/game_config.gd"
AssetDB="*res://autoload/asset_db.gd"
MatchState="*res://autoload/match_state.gd"
TeamManager="*res://autoload/team_manager.gd"
AudioManager="*res://autoload/audio_manager.gd"
StreakManager="*res://autoload/streak_manager.gd"
CommandOps="*res://autoload/command_ops.gd"
UserSettings="*res://autoload/user_settings.gd"
ImpactFx="*res://autoload/impact_fx.gd"
AppState="*res://autoload/app_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="team_gti"
2d_physics/layer_3="team_havoc"
2d_physics/layer_4="projectile"
2d_physics/layer_5="pickup"
2d_physics/layer_6="vehicle"
2d_physics/layer_7="vision_blocker"

[physics]

2d/default_gravity=0.0
2d/default_gravity_vector=Vector2(0, 0)

[rendering]

anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
renderer/rendering_method.mobile="gl_compatibility"
viewport/hdr_2d=false
anti_aliasing/quality/msaa_2d=1
environment/glow/upscale_mode=0
environment/defaults/default_clear_color=Color(0.11, 0.094, 0.076, 1)
